#compdef tmux-sessionizer ts

local state
local -a projects worktrees

# A project name is <repo>/<branch>; a bare <repo> resolves to one of them.
projects=(doc $HOME/work/*(N/:t))

worktrees=($HOME/work/*/*(N/))
projects+=(${worktrees#$HOME/work/})

_arguments -s \
  '(- *)'{-h,--help}'[show help]' \
  '(-e --existing)'{-e,--existing}'[show only existing tmux sessions]' \
  '(-w --worktrees)'{-w,--worktrees}'[show git worktrees of the current repository]' \
  ':project:->project'

case $state in
  project) compadd -a projects ;;
esac
