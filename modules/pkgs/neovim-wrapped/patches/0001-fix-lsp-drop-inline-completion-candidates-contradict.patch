+      })
+      feed('if')
+      screen:expect([[
+        function fibonacci()                                 |
+        f{1:^oobar}                                               |
+        {1:~                                                    }|*11
+        {3:-- INSERT --}                                         |
+      ]])
+      feed('x')
+      screen:expect([[
+        function fibonacci()                                 |
+        fx^                                                   |
+        {1:~                                                    }|*11
+        {3:-- INSERT --}                                         |
+      ]])
+    end)
+
+    it('keeps a candidate that matching input still agrees with', function()
+      serve({
+        {
+          insertText = 'foobar',
+          range = {
+            start = { line = 1, character = 0 },
+            ['end'] = { line = 1, character = 1 },
+          },
+        },
+      })
+      feed('if')
+      screen:expect([[
+        function fibonacci()                                 |
+        f{1:^oobar}                                               |
+        {1:~                                                    }|*11
+        {3:-- INSERT --}                                         |
+      ]])
+      feed('o')
+      screen:expect([[
+        function fibonacci()                                 |
+        fo{1:^obar}                                               |
+        {1:~                                                    }|*11
+        {3:-- INSERT --}                                         |
+      ]])
+    end)
+
+    it('keeps a candidate that replaces text inside its own range', function()
+      serve({
+        {
