+            start = { line = 1, character = 0 },
+            ['end'] = { line = 1, character = 1 },
+          },
+        },
+        {
+          insertText = 'fbaz',
+          range = {
+            start = { line = 1, character = 0 },
+            ['end'] = { line = 1, character = 1 },
+          },
+        },
+      })
+      feed('ifo')
+      screen:expect([[
+        function fibonacci()                                 |
+        fo{1:^obar}                                               |
+        {1:~                                                    }|*11
+        {3:-- INSERT --}                                         |
+      ]])
