#!/usr/bin/env bash

# No local Wayland session means this machine is being driven over SSH, so the
# browser belongs on the client. Its graphical environment lives in the
# client's systemd --user manager, which `ssh host cmd` does not inherit.
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
  # tmux refreshes SSH_CONNECTION on every attach; a pane's own copy is only
  # whatever was current when the pane was created.
  if [ -n "${TMUX:-}" ]; then
    connection=$(tmux show-environment SSH_CONNECTION)
    connection=${connection#SSH_CONNECTION=}
  else
    connection=${SSH_CONNECTION?no display and no SSH client: nowhere to open}
  fi

  # known_hosts is keyed by short name, so the client address alone will not do.
  read -r _ fqdn _ < <(getent hosts "${connection%% *}")

  # The transient unit tears its cgroup down when open-url returns, which
  # would kill the browser it just backgrounded. KillMode=process spares it.
  exec ssh "${fqdn%%.*}" systemd-run --user --collect --quiet \
    -p KillMode=process -- open-url "$@"
fi

zen "$@" &
disown

window_id=$(niri msg --json windows | jq --raw-output '[.[] | select(.app_id == "zen")] | sort_by(.focus_timestamp.secs) | last | .id // empty')
[ -n "$window_id" ] && niri msg action focus-window --id "$window_id"
