diff --git a/src/layout/floating.rs b/src/layout/floating.rs
index d102f40d..f170dea6 100644
--- a/src/layout/floating.rs
+++ b/src/layout/floating.rs
@@ -1124,6 +1124,49 @@ impl<W: LayoutElement> FloatingSpace<W> {
         let original_window_size = resize.original_window_size;
         let edges = resize.data.edges;
 
+        let idx = self.idx_of(window).unwrap();
+        let keep_aspect_ratio = self.tiles[idx].window().rules().keep_aspect_ratio == Some(true);
+        if keep_aspect_ratio && original_window_size.w > 0. && original_window_size.h > 0. {
+            let mut scale_x = None;
+            if edges.intersects(ResizeEdge::LEFT_RIGHT) {
+                let dx = if edges.contains(ResizeEdge::LEFT) {
+                    -delta.x
+                } else {
+                    delta.x
+                };
+                scale_x = Some((original_window_size.w + dx) / original_window_size.w);
+            }
+
+            let mut scale_y = None;
+            if edges.intersects(ResizeEdge::TOP_BOTTOM) {
+                let dy = if edges.contains(ResizeEdge::TOP) {
+                    -delta.y
+                } else {
+                    delta.y
+                };
+                scale_y = Some((original_window_size.h + dy) / original_window_size.h);
+            }
+
+            // On a corner, follow whichever axis the pointer moved further along.
+            let scale = match (scale_x, scale_y) {
+                (Some(x), Some(y)) => {
+                    if (x - 1.).abs() >= (y - 1.).abs() {
+                        x
+                    } else {
+                        y
+                    }
+                }
+                (Some(s), None) | (None, Some(s)) => s,
+                (None, None) => return true,
+            };
+
+            let window_width = (original_window_size.w * scale).round() as i32;
+            let window_height = (original_window_size.h * scale).round() as i32;
+            self.set_window_width(Some(window), SizeChange::SetFixed(window_width), false);
+            self.set_window_height(Some(window), SizeChange::SetFixed(window_height), false);
+            return true;
+        }
+
         if edges.intersects(ResizeEdge::LEFT_RIGHT) {
             let mut dx = delta.x;
             if edges.contains(ResizeEdge::LEFT) {
diff --git a/src/layout/tests.rs b/src/layout/tests.rs
index 31265dd9..b536b428 100644
--- a/src/layout/tests.rs
+++ b/src/layout/tests.rs
@@ -348,10 +348,12 @@ prop_compose! {
     fn arbitrary_rules()(
         focus_ring in arbitrary_focus_ring(),
         border in arbitrary_border(),
+        keep_aspect_ratio in prop::option::of(any::<bool>()),
     ) -> ResolvedWindowRules {
         ResolvedWindowRules {
             focus_ring,
             border,
+            keep_aspect_ratio,
             ..ResolvedWindowRules::default()
         }
     }
@@ -3085,6 +3087,59 @@ fn interactive_resize_to_negative() {
     check_ops(ops);
 }
 
+fn interactive_resize_keeping_aspect_ratio(
+    edges: ResizeEdge,
+    dx: f64,
+    dy: f64,
+) -> Size<i32, Logical> {
+    let ops = [
+        Op::AddOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams {
+                is_floating: true,
+                bbox: Rectangle::from_size(Size::from((160, 90))),
+                rules: Some(ResolvedWindowRules {
+                    keep_aspect_ratio: Some(true),
+                    ..ResolvedWindowRules::default()
+                }),
+                ..TestWindowParams::new(1)
+            },
+        },
+        Op::InteractiveResizeBegin { window: 1, edges },
+        Op::InteractiveResizeUpdate { window: 1, dx, dy },
+    ];
+
+    let layout = check_ops(ops);
+    let (_, win) = layout.windows().next().unwrap();
+    win.requested_size().unwrap()
+}
+
+#[test]
+fn interactive_resize_keeps_aspect_ratio() {
+    let size = |w, h| Size::from((w, h));
+    assert_eq!(
+        interactive_resize_keeping_aspect_ratio(ResizeEdge::RIGHT, 80., 0.),
+        size(240, 135)
+    );
+    assert_eq!(
+        interactive_resize_keeping_aspect_ratio(ResizeEdge::LEFT, 80., 0.),
+        size(80, 45)
+    );
+    assert_eq!(
+        interactive_resize_keeping_aspect_ratio(ResizeEdge::TOP, 0., -90.),
+        size(320, 180)
+    );
+    // On a corner, the axis that moved further wins.
+    assert_eq!(
+        interactive_resize_keeping_aspect_ratio(ResizeEdge::BOTTOM_RIGHT, 10., 90.),
+        size(320, 180)
+    );
+    assert_eq!(
+        interactive_resize_keeping_aspect_ratio(ResizeEdge::BOTTOM_RIGHT, 160., 9.),
+        size(320, 180)
+    );
+}
+
