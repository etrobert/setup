#compdef tmux-sessionizer ts

local state
local -a projects worktrees

projects=(setup doc)
[[ -d $HOME/work ]] && projects+=($HOME/work/*(N/:t))

# <repo>/<branch>, the name project_dir resolves back to ~/worktrees.
worktrees=($HOME/worktrees/*/*(N/))
projects+=(${worktrees#$HOME/worktrees/})

_arguments -s \
  '(- *)'{-h,--help}'[show help]' \
  '(-e --existing)'{-e,--existing}'[show only existing tmux sessions]' \
  '(-w --worktrees)'{-w,--worktrees}'[show git worktrees of the current repository]' \
  ':project:->project'

case $state in
  project) compadd -a projects ;;
esac
