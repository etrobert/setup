#!/usr/bin/env bash

# The client's graphical environment lives in its systemd --user manager,
# which `ssh host cmd` does not inherit.
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
  # tmux refreshes SSH_CONNECTION on every attach; a pane's own copy is only
  # whatever was current when the pane was created.
  if [ -n "${TMUX:-}" ]; then
    connection=$(tmux show-environment SSH_CONNECTION)
    connection=${connection#SSH_CONNECTION=}
    # tmux prints "-NAME" when the variable was absent from the client env.
    [ "$connection" != "-SSH_CONNECTION" ] ||
      { echo "no display and no SSH client: nowhere to open" >&2; exit 1; }
  else
    connection=${SSH_CONNECTION?no display and no SSH client: nowhere to open}
  fi

  # known_hosts is keyed by short name, so the client address alone will not do.
  read -r _ fqdn _ < <(getent hosts "${connection%% *}")

  # ssh joins argv into one string that the remote shell re-parses, so quote it.
  # KillMode=process spares the browser the transient unit's cgroup teardown.
  exec ssh -n "${fqdn%%.*}" "$(printf '%q ' systemd-run --user --collect \
    --quiet -p KillMode=process -- open-url "$@")"
fi

zen "$@" &
disown

window_id=$(niri msg --json windows | jq --raw-output '[.[] | select(.app_id == "zen")] | sort_by(.focus_timestamp.secs) | last | .id // empty')
[ -n "$window_id" ] && niri msg action focus-window --id "$window_id"
