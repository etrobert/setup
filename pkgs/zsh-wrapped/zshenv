# Import graphical-session vars (NIRI_SOCKET, ...) from the systemd user
# manager so shells outside the session (SSH, tmux, cron) can use them.
if [[ -z $NIRI_SOCKET ]] && command -v systemctl >/dev/null; then
  for line in ${(f)"$(systemctl --user show-environment 2>/dev/null)"}; do
    case $line in
      (NIRI_SOCKET=* | WAYLAND_DISPLAY=* | DISPLAY=* | DBUS_SESSION_BUS_ADDRESS=*)
        [[ -v ${line%%=*} ]] || export "$line"
        ;;
    esac
  done
  unset line
fi
