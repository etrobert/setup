# Make graphical-session tools (niri msg, wl-copy, notify-send, ...) work in
# shells that did not descend from the compositor (SSH logins, tmux servers
# started before login, background jobs): niri-session pushes the session
# variables to the systemd user manager, so import them from there. Variables
# already set (e.g. DISPLAY under X11 forwarding) are left untouched.
if [[ -z $NIRI_SOCKET ]] && (( $+commands[systemctl] )); then
  for _line in ${(f)"$(systemctl --user show-environment 2>/dev/null)"}; do
    case $_line in
      (NIRI_SOCKET=* | WAYLAND_DISPLAY=* | DISPLAY=* | DBUS_SESSION_BUS_ADDRESS=*)
        [[ -v ${_line%%=*} ]] || export "$_line"
        ;;
    esac
  done
  unset _line
fi
