typeset -U path cdpath fpath manpath

# Use viins keymap as the default.
bindkey -v

setopt INTERACTIVE_COMMENTS

# /etc/zshrc sets SHARE_HISTORY, which appends entries with timestamps. Without
# EXTENDED_HISTORY every clean shell exit rewrites the file and strips them.
setopt EXTENDED_HISTORY

HISTSIZE="999999999"
SAVEHIST="999999999"

HISTFILE="$HOME/.zsh_history"

zmodload zsh/datetime

preexec() {
  if [[ -z $_cmd_start ]]; then
    _cmd_start=$EPOCHREALTIME
  fi

  print -n '\e]133;C\a'
}

precmd() {
  if [[ -z $_cmd_start ]]; then
    return
  fi

  local _elapsed=$((EPOCHREALTIME * 1000 - _cmd_start * 1000))
  # Remove the decimal part to get the elapsed time in milliseconds as an integer
  export LAST_CMD_TIME=${_elapsed%%.*}
  unset _cmd_start
}

# Prints the previous command's output, taken from the tmux pane between the
# OSC 133 marks that PS1 and preexec emit.
lastout() {
  if [[ -z $TMUX_PANE ]]; then
    print -u2 'lastout: not inside tmux'
    return 1
  fi

  # -F prefixes every line with its flags, P starting a prompt and O the output
  # of a command. grep keeps only those, so the loop below stays short even with
  # a full scrollback. -F cannot be combined with -J, which is why the text is
  # fetched separately at the end.
  local -a marks
  marks=("${(@f)$(tmux capture-pane -pF -t "$TMUX_PANE" -S - |
    grep --line-number '^[A-Z]*[OP][A-Z]* ')}")

  local mark flags
  local -a prompts outputs
  for mark in $marks; do
    flags=${${mark#*:}%% *}
    [[ $flags == *P* ]] && prompts+=${mark%%:*}
    [[ $flags == *O* ]] && outputs+=${mark%%:*}
  done

  # The last command occupies the region between the final two prompts.
  local first=0 output
  if (( $#prompts >= 2 )); then
    for output in $outputs; do
      if (( output > prompts[-2] && output < prompts[-1] )); then
        first=$output
        break
      fi
    done
  fi

  if (( first == 0 )); then
    print -u2 'lastout: the last command left no output in the scrollback'
    return 1
  fi

  # grep counts lines from 1, tmux counts them from 0 at the start of history.
  tmux capture-pane -pJ -t "$TMUX_PANE" \
    -S "#{e|-:$((first - 1)),#{history_size}}" \
    -E "#{e|-:$((prompts[-1] - 2)),#{history_size}}"
}

# -i needed to avoid errors on mac
# -d: ZDOTDIR is a read-only store path; the default dump can't be cached.
autoload -Uz compinit && compinit -i -d "$HOME/.zcompdump"

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M viins "^F" edit-command-line
bindkey -M vicmd "^F" edit-command-line

bindkey '^?' backward-delete-char
bindkey '^H' backward-delete-char

# Override vi mode defaults: Ctrl-P/N for history search
bindkey "^P" up-line-or-search
bindkey "^N" down-line-or-search

bindkey -M viins "^A" beginning-of-line
bindkey -M vicmd "^A" beginning-of-line
bindkey -M viins "^E" end-of-line
bindkey -M vicmd "^E" end-of-line

bindkey -M vicmd '^U' vi-kill-line

bindkey "^Y" autosuggest-accept

# Moved here from profile because on darwin profile loads before agenix
[ -f /run/agenix/openai-api-key ] && export OPENAI_API_KEY="$(cat /run/agenix/openai-api-key)"
[ -f /run/agenix/gemini-api-key ] && export GEMINI_API_KEY="$(cat /run/agenix/gemini-api-key)"
